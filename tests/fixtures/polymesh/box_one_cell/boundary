FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    inlet
    {
        type            patch;
        physicalType    patch;
        nFaces          1;
        startFace       0;
    }
    outlet
    {
        type            patch;
        physicalType    patch;
        nFaces          1;
        startFace       1;
    }
    walls
    {
        type            patch;
        physicalType    patch;
        nFaces          2;
        startFace       2;
    }
    frontAndBack
    {
        type            patch;
        physicalType    patch;
        nFaces          2;
        startFace       4;
    }
)

