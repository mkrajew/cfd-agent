FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Steady state: there is no time derivative; the iteration is pseudo-time stepping only.
ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

// Second-order linear-upwind convection: the cell Reynolds number is large in the axial direction
// (U dx / nu = 0.05 * 0.002 / 1e-6 = 100), and first-order upwind would add numerical diffusion
// that thickens the developing boundary layer.
divSchemes
{
    default         none;
    div(phi,U)      bounded Gauss linearUpwind grad(U);
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

// Cells are almost orthogonal, but the correction costs nothing here.
laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

// ************************************************************************* //
