FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// Kinematic viscosity [m^2/s]. With density 1 kg/m^3 this is the dynamic viscosity 0.005 Pa s.
// Re = U D / nu = 1 m/s * 0.1 m / 0.005 m^2/s = 20.
nu              0.005;

