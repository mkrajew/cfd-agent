FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// Kinematic viscosity [m^2/s]. With density 1 kg/m^3 this is the dynamic viscosity 0.001 Pa s.
// Re = U L / nu = 1 m/s * 1 m / 0.001 m^2/s = 1000.
nu              0.001;

